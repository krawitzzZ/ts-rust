{
  // Inlined from @docusaurus/tsconfig so we can drop deprecated `baseUrl`.
  // Paths are relative to this file (the TypeScript 6 replacement for baseUrl).
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["node"]
  },
  "exclude": [".docusaurus", "build"]
}
